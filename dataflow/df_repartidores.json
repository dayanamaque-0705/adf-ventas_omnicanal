{
	"name": "df_repartidores",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "repartidores_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "repartidores_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "aggregate1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          repartidor_id as string,",
				"          nombre_repartidor as string,",
				"          tipo_vehiculo as string,",
				"          ciudad_base as string,",
				"          fecha_alta as string,",
				"          activo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 aggregate(groupBy(repartidor_id),",
				"     nombre_repartidor = first(nombre_repartidor, true()),",
				"          tipo_vehiculo = first(tipo_vehiculo, true()),",
				"          ciudad_base = first(ciudad_base, true()),",
				"          fecha_alta = first(fecha_alta, true()),",
				"          activo = first(activo, true())) ~> aggregate1",
				"aggregate1 derive(nombre_repartidor = trim(toString(nombre_repartidor)),",
				"          tipo_vehiculo = trim(toString(tipo_vehiculo)),",
				"          ciudad_base = iif(isNull(ciudad_base) || length(trim(toString(ciudad_base))) == 0, 'Sin Ciudad', iif(trim(toString(ciudad_base)) == 'CBA', 'Cochabamba', trim(toString(ciudad_base)))),",
				"          activo = iif(trim(lower(toString(activo))) == 'sí' || trim(lower(toString(activo))) == 'si' || trim(lower(toString(activo))) == 'activo', true(), false()),",
				"          fecha_alta = iif(isNull(fecha_alta) || length(trim(toString(fecha_alta))) == 0, toDate(toString(null())), toDate(replace(trim(toString(fecha_alta)), '/', '-'), iif(instr(toString(fecha_alta), '/') > 0, 'dd-MM-yyyy', 'yyyy-MM-dd')))) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(repartidor_id) && !isNull(fecha_alta),",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"split1@validos sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          repartidor_id as string,",
				"          nombre_repartidor as string,",
				"          tipo_vehiculo as string,",
				"          ciudad_base as string,",
				"          fecha_alta as date,",
				"          activo as boolean",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          repartidor_id,",
				"          nombre_repartidor,",
				"          tipo_vehiculo,",
				"          ciudad_base,",
				"          fecha_alta,",
				"          activo",
				"     )) ~> sink1"
			]
		}
	}
}