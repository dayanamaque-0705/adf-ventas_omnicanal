{
	"name": "df_sucursales",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "sucursales_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "sucursales_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "aggregate1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          sucursal_id as string,",
				"          restaurante_id as string,",
				"          nombre_sucursal as string,",
				"          ciudad as string,",
				"          zona as string,",
				"          direccion as string,",
				"          capacidad_mesas as string,",
				"          tiene_delivery as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 aggregate(groupBy(sucursal_id),",
				"     restaurante_id = first(restaurante_id, true()),",
				"          nombre_sucursal = first(nombre_sucursal, true()),",
				"          ciudad = first(ciudad, true()),",
				"          zona = first(zona, true()),",
				"          direccion = first(direccion, true()),",
				"          capacidad_mesas = first(capacidad_mesas, true()),",
				"          tiene_delivery = first(tiene_delivery, true())) ~> aggregate1",
				"aggregate1 derive(nombre_sucursal = trim(toString(nombre_sucursal)),",
				"          ciudad = trim(toString(ciudad)),",
				"          zona = trim(toString(zona)),",
				"          capacidad_mesas = iif(trim(lower(toString(capacidad_mesas))) == 'veinte', 20, toInteger(trim(toString(capacidad_mesas)))),",
				"          tiene_delivery = iif(trim(lower(toString(tiene_delivery))) == 'sí' || trim(lower(toString(tiene_delivery))) == 'si', true(), false())) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(sucursal_id) && !isNull(restaurante_id) && !isNull(capacidad_mesas) && capacidad_mesas > 0,",
				"     disjoint: false) ~> split1@(valido, rechazado)",
				"split1@valido sink(allowSchemaDrift: true,",
				"     validateSchema: true,",
				"     input(",
				"          sucursal_id as string,",
				"          restaurante_id as string,",
				"          nombre_sucursal as string,",
				"          ciudad as string,",
				"          zona as string,",
				"          direccion as string,",
				"          capacidad_mesas as integer,",
				"          tiene_delivery as boolean",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          sucursal_id,",
				"          restaurante_id,",
				"          nombre_sucursal,",
				"          ciudad,",
				"          zona,",
				"          direccion,",
				"          capacidad_mesas,",
				"          tiene_delivery",
				"     )) ~> sink1"
			]
		}
	}
}