{
	"name": "df_entregas",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "entregas_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "entregas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          entrega_id as string,",
				"          pedido_id as string,",
				"          repartidor_id as string,",
				"          hora_salida as string,",
				"          hora_entrega as string,",
				"          tiempo_entrega_min as string,",
				"          distancia_km as string,",
				"          estado_entrega as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(distancia_km = toDecimal(replace(toString(distancia_km), ',', '.'), 5, 2),",
				"          tiempo_entrega_min = toInteger(tiempo_entrega_min),",
				"          hora_salida = toTimestamp(hora_salida, 'yyyy-MM-dd HH:mm:ss'),",
				"          hora_entrega = toTimestamp(hora_salida, 'yyyy-MM-dd HH:mm:ss')) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(entrega_id) && !isNull(pedido_id) && !isNull(repartidor_id) && !isNull(hora_salida) && (isNull(tiempo_entrega_min) || tiempo_entrega_min >= 0) && distancia_km >= 0.00,",
				"     disjoint: false) ~> split1@(validados, rechazados)",
				"split1@validados aggregate(groupBy(entrega_id),",
				"     pedido_id = first(pedido_id, true()),",
				"          repartidor_id = first(repartidor_id, true()),",
				"          hora_salida = first(hora_salida, true()),",
				"          hora_entrega = first(hora_entrega, true()),",
				"          distancia_km = first(distancia_km, true()),",
				"          tiempo_entrega_min = first(tiempo_entrega_min, true()),",
				"          estado_entrega = first(estado_entrega, true())) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          entrega_id as string,",
				"          pedido_id as string,",
				"          repartidor_id as string,",
				"          hora_salida as timestamp,",
				"          hora_entrega as timestamp,",
				"          tiempo_entrega_min as integer,",
				"          distancia_km as decimal(6,2),",
				"          estado_entrega as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          entrega_id,",
				"          pedido_id,",
				"          repartidor_id,",
				"          hora_salida,",
				"          hora_entrega,",
				"          tiempo_entrega_min,",
				"          distancia_km,",
				"          estado_entrega",
				"     )) ~> sink1"
			]
		}
	}
}