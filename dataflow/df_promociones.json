{
	"name": "df_promociones",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "promociones_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "promociones_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "aggregate1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          promocion_id as string,",
				"          nombre_promocion as string,",
				"          fecha_inicio as string,",
				"          fecha_fin as string,",
				"          porcentaje_descuento as string,",
				"          canal_aplicable as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 aggregate(groupBy(promocion_id),",
				"     nombre_promocion = first(nombre_promocion, true()),",
				"          fecha_inicio = first(fecha_inicio, true()),",
				"          fecha_fin = first(fecha_fin, true()),",
				"          porcentaje_descuento = first(porcentaje_descuento, true()),",
				"          canal_aplicable = first(canal_aplicable, true())) ~> aggregate1",
				"split1@validos derive(nombre_promocion = trim(toString(nombre_promocion)),",
				"          fecha_inicio = toDate(trim(toString(fecha_inicio)), 'yyyy-MM-dd'),",
				"          fecha_fin = toDate(trim(toString(fecha_fin)), 'yyyy-MM-dd'),",
				"          canal_aplicable = iif(isNull(canal_aplicable) || length(trim(toString(canal_aplicable))) == 0, 'Sin Canal', trim(toString(canal_aplicable))),",
				"          porcentaje_descuento = toDecimal(replace(toString(porcentaje_descuento), ',', '.'), 5, 2)) ~> derivedColumn1",
				"aggregate1 split(!isNull(promocion_id) && (isNull(fecha_inicio) || isNull(fecha_fin) || fecha_fin >= fecha_inicio),",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          promocion_id as string,",
				"          nombre_promocion as string,",
				"          fecha_inicio as date,",
				"          fecha_fin as date,",
				"          porcentaje_descuento as decimal(5,2),",
				"          canal_aplicable as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          promocion_id,",
				"          nombre_promocion,",
				"          fecha_inicio,",
				"          fecha_fin,",
				"          porcentaje_descuento,",
				"          canal_aplicable",
				"     )) ~> sink1"
			]
		}
	}
}